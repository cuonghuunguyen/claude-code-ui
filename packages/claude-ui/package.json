{
  "name": "claude-code-ui",
  "version": "0.5.1",
  "description": "Browser UI for Claude Agent SDK sessions, run by a local daemon",
  "type": "module",
  "bin": { "claude-ui": "dist/launcher.js" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/cuonghuunguyen/claude-code-ui.git", "directory": "packages/claude-ui" },
  "homepage": "https://github.com/cuonghuunguyen/claude-code-ui#readme",
  "bugs": { "url": "https://github.com/cuonghuunguyen/claude-code-ui/issues" },
  "keywords": ["claude", "claude-code", "claude-agent-sdk", "web-ui", "daemon"],
  "files": ["dist", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "npm run build -w @claude-ui/web && node scripts/build.mjs",
    "prepack": "npm run build",
    "pack-check": "node scripts/pack-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "fuzzysort": "^3.1.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
